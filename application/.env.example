# Safe example environment for the publishable repository derivative.
# Replace values locally; never commit real credentials.
SECRET_KEY=replace-with-a-local-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ecommerce_benchmark
DB_USER=benchuser
DB_PASSWORD=replace-with-local-db-password
DB_HOST=localhost
DB_PORT=6432
DB_CONN_MAX_AGE=60
DJANGO_DISABLE_SERVER_SIDE_CURSORS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8081,http://127.0.0.1:8000
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
